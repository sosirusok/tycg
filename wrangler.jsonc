{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zombiego-market",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Tick A every 10 minutes (자동 끌올, 09:00-02:00 KST), tick B 5 minutes later ('끌올 가능' 알림), and the
  // daily cleanup of expired sessions and unused photos (03:17 KST). 3 of the account's 5 cron triggers:
  // any other Worker on the same Cloudflare account may use at most 2.
  "triggers": { "crons": ["*/10 * * * *", "5-59/10 * * * *", "17 18 * * *"] },
  "assets": {
    // The React app is a single-page app; unknown paths fall back to index.html.
    // Only /api/* requests invoke the Worker, so static files never cost CPU time.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zombiego-market-db",
      // Local placeholder. The deploy script fills in the real ID in CI only.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Optional. Without an R2 bucket, uploaded photos are stored in KV (binding PHOTOS, namespace
  // zombiego-market-photos), or in D1 without both. deploy.yml finds or creates the namespace and adds
  // the kv_namespaces binding to the runner's copy of this file; it is never committed here.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "zombiego-market-uploads"
    }
  ]
}
